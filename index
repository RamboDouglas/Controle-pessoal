<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Controle Financeiro</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root {
  --bg:#09090f;--surface:#111119;--card:#161621;--card2:#1d1d2e;
  --border:#252535;--border2:#2e2e42;
  --gold:#daa520;--gold2:#f0c040;
  --success:#10d9a0;--danger:#ff4d6a;--warning:#fbbf24;--info:#6366f1;
  --text:#e2e2f0;--text2:#8888a8;--text3:#5a5a72;
  --r:12px;--r2:8px;--shadow:0 4px 24px rgba(0,0,0,.4);--tr:.2s ease;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
h1,h2,h3,.syne{font-family:'Syne',sans-serif}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--surface)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}

/* LAYOUT */
.wrap{max-width:1080px;margin:0 auto;padding:0 1rem}

/* HEADER */
.app-header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 0 .8rem;border-bottom:1px solid var(--border)}
.logo{display:flex;align-items:center;gap:.6rem}
.logo-icon{width:36px;height:36px;background:linear-gradient(135deg,var(--gold),#b8860b);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.logo h1{font-size:1.2rem;font-weight:700;letter-spacing:-.02em}
.logo span{color:var(--gold)}
.header-date{font-size:.78rem;color:var(--text2)}

/* TABS */
.tab-nav{display:flex;gap:.2rem;padding:.6rem 0;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.tab-nav::-webkit-scrollbar{display:none}
.tab-btn{display:flex;align-items:center;gap:.4rem;padding:.45rem .9rem;border:none;background:none;color:var(--text2);font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:500;cursor:pointer;border-radius:var(--r2);white-space:nowrap;transition:all var(--tr)}
.tab-btn:hover{color:var(--text);background:var(--card)}
.tab-btn.active{color:var(--gold);background:rgba(218,165,32,.1);font-weight:600}
.tab-content{display:none;padding:1.25rem 0 5rem;animation:fadeUp .25s ease}
.tab-content.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* CARDS */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1.1rem;margin-bottom:1.1rem}
.card-title{font-size:.73rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text2);margin-bottom:.9rem}

/* KPI GRID */
.kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin-bottom:1.1rem}
@media(min-width:600px){.kpi-grid{grid-template-columns:repeat(4,1fr)}}
.kpi-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1rem;position:relative;overflow:hidden}
.kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:var(--r) var(--r) 0 0}
.kpi-card.gold::before{background:var(--gold)}
.kpi-card.green::before{background:var(--success)}
.kpi-card.red::before{background:var(--danger)}
.kpi-card.purple::before{background:var(--info)}
.kpi-label{font-size:.72rem;color:var(--text2);font-weight:500;margin-bottom:.4rem}
.kpi-value{font-family:'Syne',sans-serif;font-size:1.25rem;font-weight:700;letter-spacing:-.02em;line-height:1}
.kpi-value.gold{color:var(--gold)}
.kpi-value.green{color:var(--success)}
.kpi-value.red{color:var(--danger)}
.kpi-value.purple{color:var(--info)}
.kpi-sub{font-size:.7rem;color:var(--text3);margin-top:.3rem}

/* CHARTS ROW */
.charts-row{display:grid;grid-template-columns:1fr;gap:1.1rem;margin-bottom:1.1rem}
@media(min-width:680px){.charts-row{grid-template-columns:1.65fr 1fr}}
.chart-wrap{position:relative;height:200px}

/* INSIGHTS */
.insights-list{display:flex;flex-direction:column;gap:.55rem}
.insight-item{display:flex;align-items:flex-start;gap:.65rem;padding:.7rem;background:var(--card2);border-radius:var(--r2);border:1px solid var(--border)}
.insight-icon{font-size:1.1rem;flex-shrink:0;margin-top:.05rem}
.insight-text{font-size:.83rem;color:var(--text2);line-height:1.45}
.insight-text strong{color:var(--text)}

/* DUE DATES */
.due-list{display:flex;flex-direction:column;gap:.5rem}
.due-item{display:flex;align-items:center;justify-content:space-between;padding:.65rem .85rem;background:var(--card2);border-radius:var(--r2);border-left:3px solid var(--warning);border-top:1px solid var(--border);border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
.due-item.overdue{border-left-color:var(--danger)}
.due-item.safe{border-left-color:var(--success)}
.due-desc{font-size:.84rem;font-weight:500}
.due-date-label{font-size:.7rem;color:var(--text2);margin-top:.1rem}
.due-amount{font-family:'Syne',sans-serif;font-size:.88rem;font-weight:700;color:var(--danger)}

/* EXTRATO */
.month-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:.9rem}
.mnav-btn{background:var(--card);border:1px solid var(--border);color:var(--text);width:34px;height:34px;border-radius:var(--r2);cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;transition:all var(--tr)}
.mnav-btn:hover{border-color:var(--gold);color:var(--gold)}
.mnav-label{font-family:'Syne',sans-serif;font-size:1.05rem;font-weight:700;letter-spacing:-.01em}
.filters-row{display:flex;gap:.45rem;margin-bottom:.75rem;flex-wrap:wrap}
.search-in{flex:1;min-width:140px;padding:.52rem .85rem;background:var(--card);border:1px solid var(--border);color:var(--text);border-radius:var(--r2);font-family:'DM Sans',sans-serif;font-size:.875rem;transition:all var(--tr)}
.search-in::placeholder{color:var(--text3)}
.search-in:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(218,165,32,.12)}
.filter-chip{padding:.48rem .8rem;background:var(--card);border:1px solid var(--border);color:var(--text2);border-radius:99px;font-family:'DM Sans',sans-serif;font-size:.78rem;font-weight:500;cursor:pointer;transition:all var(--tr);white-space:nowrap}
.filter-chip:hover,.filter-chip.active{background:rgba(218,165,32,.1);border-color:var(--gold);color:var(--gold)}

/* TRANSACTION ITEMS */
.tx-date-group{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);padding:.7rem .9rem .35rem;border-bottom:1px solid var(--border)}
.tx-item{display:flex;align-items:center;gap:.85rem;padding:.85rem .9rem;border-bottom:1px solid var(--border);transition:background var(--tr)}
.tx-item:last-child{border-bottom:none}
.tx-item:hover{background:var(--card2)}
.tx-cat-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1.05rem;flex-shrink:0}
.tx-info{flex:1;min-width:0}
.tx-desc{font-size:.875rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tx-meta{font-size:.72rem;color:var(--text2);margin-top:.12rem;display:flex;gap:.45rem;align-items:center;flex-wrap:wrap}
.tx-badge{font-size:.62rem;padding:.12rem .42rem;border-radius:99px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.tx-badge.pendente{background:rgba(251,191,36,.15);color:var(--warning)}
.tx-badge.pago{background:rgba(16,217,160,.1);color:var(--success)}
.tx-right{display:flex;flex-direction:column;align-items:flex-end;gap:.3rem}
.tx-amount{font-family:'Syne',sans-serif;font-size:.92rem;font-weight:700;white-space:nowrap}
.tx-amount.entrada{color:var(--success)}
.tx-amount.saida{color:var(--danger)}
.tx-actions{display:flex;gap:.2rem;opacity:0;transition:opacity var(--tr)}
.tx-item:hover .tx-actions{opacity:1}
.tx-act-btn{width:26px;height:26px;border:none;background:var(--surface);border-radius:6px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.8rem;transition:all var(--tr)}
.tx-act-btn.edit:hover{background:rgba(218,165,32,.2)}
.tx-act-btn.del:hover{background:rgba(255,77,106,.2)}
.empty-state{text-align:center;padding:2.5rem 1rem;color:var(--text3)}
.empty-icon{font-size:2rem;margin-bottom:.6rem}
.empty-state p{font-size:.875rem}

/* REPORT */
.report-row{display:flex;gap:.75rem;align-items:flex-end;flex-wrap:wrap;margin-bottom:1.1rem}
.report-row .fg{flex:1;min-width:120px;margin-bottom:0}
.cat-breakdown{display:flex;flex-direction:column;gap:.65rem}
.cat-row{display:flex;align-items:center;gap:.7rem}
.cat-row-icon{font-size:1.05rem;width:22px;text-align:center;flex-shrink:0}
.cat-row-info{flex:1}
.cat-row-label{font-size:.8rem;font-weight:500;display:flex;justify-content:space-between;margin-bottom:.28rem}
.cat-row-label .cat-val{color:var(--danger);font-family:'Syne',sans-serif;font-size:.8rem}
.bar-track{height:3px;background:var(--border2);border-radius:99px;overflow:hidden}
.bar-fill{height:100%;border-radius:99px;transition:width .5s ease}

/* FORMS */
.fg{margin-bottom:.9rem}
.form-label{display:block;font-size:.75rem;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem}
.form-control{width:100%;padding:.65rem .85rem;background:var(--surface);border:1px solid var(--border2);color:var(--text);border-radius:var(--r2);font-family:'DM Sans',sans-serif;font-size:.875rem;transition:all var(--tr)}
.form-control::placeholder{color:var(--text3)}
.form-control:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(218,165,32,.12)}
input[type="date"]::-webkit-calendar-picker-indicator{filter:invert(.7);cursor:pointer}

/* TYPE TOGGLE */
.type-toggle{display:flex;gap:.45rem;margin-bottom:.9rem}
.type-btn{flex:1;padding:.65rem;border:1px solid var(--border2);background:var(--surface);border-radius:var(--r2);color:var(--text2);font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:600;cursor:pointer;transition:all var(--tr);text-align:center}
.type-btn.act-entrada{background:rgba(16,217,160,.1);border-color:var(--success);color:var(--success)}
.type-btn.act-saida{background:rgba(255,77,106,.1);border-color:var(--danger);color:var(--danger)}

/* CATEGORY GRID */
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem;margin-bottom:.9rem}
.cat-opt{display:flex;flex-direction:column;align-items:center;gap:.22rem;padding:.55rem .25rem;border:1px solid var(--border2);background:var(--surface);border-radius:var(--r2);cursor:pointer;transition:all var(--tr);text-align:center}
.cat-opt:hover{border-color:var(--gold)}
.cat-opt.sel{border-color:var(--gold);background:rgba(218,165,32,.1)}
.cat-opt .ce{font-size:1.1rem}
.cat-opt .cn{font-size:.6rem;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}

/* STATUS TOGGLE */
.status-toggle{display:flex;gap:.45rem;margin-bottom:.9rem}
.status-btn{flex:1;padding:.55rem;border:1px solid var(--border2);background:var(--surface);border-radius:var(--r2);color:var(--text2);font-family:'DM Sans',sans-serif;font-size:.82rem;font-weight:600;cursor:pointer;transition:all var(--tr);text-align:center}
.status-btn.act-pago{background:rgba(16,217,160,.1);border-color:var(--success);color:var(--success)}
.status-btn.act-pendente{background:rgba(251,191,36,.1);border-color:var(--warning);color:var(--warning)}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.7rem 1.2rem;border:none;border-radius:var(--r2);font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:600;cursor:pointer;transition:all var(--tr);white-space:nowrap}
.btn-primary{background:var(--gold);color:#000;width:100%}
.btn-primary:hover{background:var(--gold2);transform:translateY(-1px);box-shadow:0 4px 16px rgba(218,165,32,.3)}
.btn-secondary{background:var(--card2);color:var(--text2);border:1px solid var(--border)}
.btn-secondary:hover{border-color:var(--border2);color:var(--text)}
.btn-danger{background:rgba(255,77,106,.1);color:var(--danger);border:1px solid rgba(255,77,106,.3)}
.btn-danger:hover{background:var(--danger);color:#fff}
.btn-sm{padding:.45rem .85rem;font-size:.8rem}

/* FAB */
.fab{position:fixed;bottom:1.75rem;right:1.75rem;width:54px;height:54px;border-radius:15px;background:linear-gradient(135deg,var(--gold),#b8860b);border:none;color:#000;font-size:1.4rem;cursor:pointer;box-shadow:0 8px 24px rgba(218,165,32,.45);display:flex;align-items:center;justify-content:center;transition:all var(--tr);z-index:100;font-weight:700}
.fab:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 12px 32px rgba(218,165,32,.55)}

/* MODALS */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:500;align-items:flex-end;justify-content:center;backdrop-filter:blur(4px)}
.modal-overlay.open{display:flex;animation:overlayIn .2s ease}
@keyframes overlayIn{from{opacity:0}to{opacity:1}}
.modal-panel{background:var(--card);border-radius:var(--r) var(--r) 0 0;border:1px solid var(--border);border-bottom:none;width:100%;max-width:500px;max-height:92vh;overflow-y:auto;padding:1.4rem;animation:slideUp .3s ease}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@media(min-width:680px){
  .modal-overlay{align-items:center}
  .modal-panel{border-radius:var(--r);border:1px solid var(--border);animation:scaleIn .2s ease}
  @keyframes scaleIn{from{transform:scale(.95);opacity:0}to{transform:scale(1);opacity:1}}
}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.1rem}
.modal-title{font-family:'Syne',sans-serif;font-size:1.05rem;font-weight:700}
.modal-close{width:30px;height:30px;border:none;background:var(--surface);border-radius:7px;color:var(--text2);cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;transition:all var(--tr)}
.modal-close:hover{color:var(--text);background:var(--border)}
.modal-overlay.centered{align-items:center}
.modal-panel.compact{max-width:360px;border-radius:var(--r);border:1px solid var(--border);animation:scaleIn .2s ease}
.confirm-text{font-size:.875rem;color:var(--text2);margin-bottom:1.1rem;line-height:1.5}
.confirm-btns{display:flex;gap:.65rem}
.confirm-btns .btn{flex:1}

/* TOASTS */
.notif-wrap{position:fixed;top:1rem;right:1rem;z-index:2000;display:flex;flex-direction:column;gap:.45rem;pointer-events:none}
.toast{padding:.8rem 1rem;border-radius:var(--r2);font-size:.835rem;font-weight:500;box-shadow:var(--shadow);animation:toastIn .25s ease,toastOut .25s ease 3.75s forwards;display:flex;align-items:center;gap:.5rem;max-width:300px}
.toast.success{background:var(--card2);border:1px solid var(--success);color:var(--success)}
.toast.error{background:var(--card2);border:1px solid var(--danger);color:var(--danger)}
.toast.info{background:var(--card2);border:1px solid var(--gold);color:var(--gold)}
@keyframes toastIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:translateX(0)}}
@keyframes toastOut{from{opacity:1}to{opacity:0;transform:translateX(16px)}}

.export-row{display:flex;justify-content:flex-end;gap:.65rem;margin-top:.5rem}
.mini-kpi{grid-template-columns:repeat(3,1fr) !important}
.kpi-card.sm{padding:.75rem}
.kpi-value.sm{font-size:1.05rem}
</style>
</head>
<body>
<div class="wrap">

<!-- HEADER -->
<header class="app-header">
  <div class="logo">
    <div class="logo-icon">💰</div>
    <h1>Minhas <span>Finanças</span></h1>
  </div>
  <span class="header-date" id="header-date"></span>
</header>

<!-- TABS -->
<nav class="tab-nav">
  <button class="tab-btn active" data-tab="dashboard">📊 Dashboard</button>
  <button class="tab-btn" data-tab="extrato">📋 Extrato</button>
  <button class="tab-btn" data-tab="relatorios">📈 Relatórios</button>
</nav>

<!-- ===== DASHBOARD ===== -->
<div id="tab-dashboard" class="tab-content active">
  <div class="kpi-grid" id="kpi-grid">
    <div class="kpi-card gold">
      <div class="kpi-label">💰 Saldo Total</div>
      <div class="kpi-value gold" id="kpi-saldo">R$ 0,00</div>
      <div class="kpi-sub">Total acumulado</div>
    </div>
    <div class="kpi-card green">
      <div class="kpi-label">📥 Entradas</div>
      <div class="kpi-value green" id="kpi-entradas">R$ 0,00</div>
      <div class="kpi-sub" id="kpi-ent-sub">Este mês</div>
    </div>
    <div class="kpi-card red">
      <div class="kpi-label">📤 Saídas</div>
      <div class="kpi-value red" id="kpi-saidas">R$ 0,00</div>
      <div class="kpi-sub" id="kpi-sai-sub">Este mês</div>
    </div>
    <div class="kpi-card purple">
      <div class="kpi-label">🎯 Poupança</div>
      <div class="kpi-value purple" id="kpi-poupanca">—</div>
      <div class="kpi-sub">% da renda economizada</div>
    </div>
  </div>

  <div class="charts-row">
    <div class="card">
      <div class="card-title">Evolução dos últimos 6 meses</div>
      <div class="chart-wrap"><canvas id="chart-mensal"></canvas></div>
    </div>
    <div class="card">
      <div class="card-title">Gastos por categoria (mês atual)</div>
      <div class="chart-wrap"><canvas id="chart-cat"></canvas></div>
    </div>
  </div>

  <div class="charts-row">
    <div class="card">
      <div class="card-title">⚠️ Próximos vencimentos</div>
      <div id="due-list" class="due-list"></div>
    </div>
    <div class="card">
      <div class="card-title">💡 Insights automáticos</div>
      <div id="insights-list" class="insights-list"></div>
    </div>
  </div>
</div>

<!-- ===== EXTRATO ===== -->
<div id="tab-extrato" class="tab-content">
  <div class="month-nav">
    <button class="mnav-btn" id="prev-month">‹</button>
    <span class="mnav-label" id="month-label">Mai 2026</span>
    <button class="mnav-btn" id="next-month">›</button>
  </div>

  <div class="kpi-grid mini-kpi" style="margin-bottom:.9rem">
    <div class="kpi-card green sm">
      <div class="kpi-label" style="font-size:.68rem">Entradas</div>
      <div class="kpi-value green sm" id="ext-ent">R$ 0,00</div>
    </div>
    <div class="kpi-card red sm">
      <div class="kpi-label" style="font-size:.68rem">Saídas</div>
      <div class="kpi-value red sm" id="ext-sai">R$ 0,00</div>
    </div>
    <div class="kpi-card gold sm">
      <div class="kpi-label" style="font-size:.68rem">Saldo</div>
      <div class="kpi-value gold sm" id="ext-bal">R$ 0,00</div>
    </div>
  </div>

  <div class="filters-row">
    <input type="text" class="search-in" id="search-in" placeholder="🔍  Buscar...">
    <button class="filter-chip active" data-ftype="todos">Todos</button>
    <button class="filter-chip" data-ftype="entrada">📥 Entradas</button>
    <button class="filter-chip" data-ftype="saida">📤 Saídas</button>
  </div>
  <div class="filters-row" id="cat-chips" style="margin-bottom:.75rem"></div>

  <div class="card" style="padding:0"><div id="tx-list"></div></div>
</div>

<!-- ===== RELATÓRIOS ===== -->
<div id="tab-relatorios" class="tab-content">
  <div class="report-row">
    <div class="fg"><label class="form-label">Data início</label><input type="date" id="r-start" class="form-control"></div>
    <div class="fg"><label class="form-label">Data fim</label><input type="date" id="r-end" class="form-control"></div>
    <button class="btn btn-primary" id="btn-gerar" style="width:auto;align-self:flex-end;margin-bottom:.9rem">Gerar Relatório</button>
  </div>

  <div id="report-content" style="display:none">
    <div class="kpi-grid mini-kpi" style="margin-bottom:1.1rem">
      <div class="kpi-card green"><div class="kpi-label">Entradas</div><div class="kpi-value green" id="r-ent">R$ 0,00</div></div>
      <div class="kpi-card red"><div class="kpi-label">Saídas</div><div class="kpi-value red" id="r-sai">R$ 0,00</div></div>
      <div class="kpi-card gold"><div class="kpi-label">Resultado</div><div class="kpi-value gold" id="r-res">R$ 0,00</div></div>
    </div>

    <div class="charts-row">
      <div class="card">
        <div class="card-title">Evolução do saldo no período</div>
        <div class="chart-wrap"><canvas id="r-linha"></canvas></div>
      </div>
      <div class="card">
        <div class="card-title">Distribuição das despesas</div>
        <div class="chart-wrap"><canvas id="r-pizza"></canvas></div>
      </div>
    </div>

    <div class="card">
