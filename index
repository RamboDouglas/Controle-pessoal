<script>
/* ==================== CONSTANTS ==================== */
const CAT = {
  salario:      {l:'Salário',     e:'💰',c:'#10d9a0'},
  freelance:    {l:'Freelance',   e:'💻',c:'#6366f1'},
  investimentos:{l:'Investim.',   e:'📈',c:'#a78bfa'},
  alimentacao:  {l:'Alimentação', e:'🍔',c:'#f97316'},
  transporte:   {l:'Transporte',  e:'🚗',c:'#06b6d4'},
  moradia:      {l:'Moradia',     e:'🏠',c:'#64748b'},
  saude:        {l:'Saúde',       e:'💊',c:'#ec4899'},
  educacao:     {l:'Educação',    e:'🎓',c:'#3b82f6'},
  lazer:        {l:'Lazer',       e:'🎮',c:'#fbbf24'},
  contas:       {l:'Contas',      e:'💡',c:'#94a3b8'},
  vestuario:    {l:'Vestuário',   e:'👕',c:'#f43f5e'},
  outros:       {l:'Outros',      e:'📦',c:'#6b7280'},
};

const MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const MONTHS_S = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

/* ==================== STATE ==================== */
let tx = [];
let exMonth = new Date();
let delId = null;
let aType = 'entrada', aCat = 'salario', aStatus = 'pago';
let eType = 'entrada', eCat = 'outros', eStatus = 'pago';
let fType = 'todos', fCat = null, fQ = '';
let rFiltered = [];
let charts = {};

/* ==================== INIT ==================== */
document.addEventListener('DOMContentLoaded', () => {
  Chart.defaults.color = '#8888a8';
  Chart.defaults.borderColor = '#252535';
  loadTx();
  setDefaultDates();
  buildCatChips();
  setupListeners();
  document.getElementById('header-date').textContent = new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  switchTab('dashboard');
  renderAll();
});

function loadTx(){
  const s = localStorage.getItem('finapp_v3');
  tx = s ? JSON.parse(s) : [];
}
function saveTx(){ localStorage.setItem('finapp_v3', JSON.stringify(tx)); }

function setDefaultDates(){
  const today = new Date().toISOString().split('T')[0];
  const now = new Date();
  document.getElementById('a-date').value = today;
  document.getElementById('r-start').value = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0];
  document.getElementById('r-end').value = today;
}

function renderAll(){
  renderDashboard();
  renderExtrato();
}

/* ==================== TAB ==================== */
function switchTab(tab){
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.querySelector(`[data-tab="${tab}"]`).classList.add('active');
  document.getElementById(`tab-${tab}`).classList.add('active');
  if(tab === 'dashboard') renderDashboard();
  if(tab === 'extrato') renderExtrato();
}

/* ==================== DASHBOARD ==================== */
function renderDashboard(){
  renderKPIs();
  renderChartMensal();
  renderChartCat();
  renderDueDates();
  renderInsights();
}

function renderKPIs(){
  const now = new Date();
  const mTx = tx.filter(t => {
    const d = new Date(t.date+'T12:00:00');
    return d.getMonth()===now.getMonth() && d.getFullYear()===now.getFullYear();
  });
  const ent = mTx.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = mTx.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const saldo = tx.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0)
              - tx.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const poupanca = ent > 0 ? Math.max(0,(ent-sai)/ent*100) : null;
  const ml = MONTHS_S[now.getMonth()]+' '+now.getFullYear();

  document.getElementById('kpi-saldo').textContent = fmtR(saldo);
  document.getElementById('kpi-saldo').className = 'kpi-value '+(saldo>=0?'gold':'red');
  document.getElementById('kpi-entradas').textContent = fmtR(ent);
  document.getElementById('kpi-saidas').textContent = fmtR(sai);
  document.getElementById('kpi-poupanca').textContent = poupanca !== null ? poupanca.toFixed(1)+'%' : '—';
  document.getElementById('kpi-ent-sub').textContent = ml;
  document.getElementById('kpi-sai-sub').textContent = ml;
}

function renderChartMensal(){
  const now = new Date();
  const labels=[], ents=[], sais=[];
  for(let i=5;i>=0;i--){
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    labels.push(MONTHS_S[d.getMonth()]+'/'+String(d.getFullYear()).slice(2));
    const mTx = tx.filter(t=>{
      const td = new Date(t.date+'T12:00:00');
      return td.getMonth()===d.getMonth() && td.getFullYear()===d.getFullYear();
    });
    ents.push(mTx.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0));
    sais.push(mTx.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0));
  }
  if(charts.mensal) charts.mensal.destroy();
  const ctx = document.getElementById('chart-mensal').getContext('2d');
  charts.mensal = new Chart(ctx,{
    type:'bar',
    data:{
      labels,
      datasets:[
        {label:'Entradas',data:ents,backgroundColor:'rgba(16,217,160,.65)',borderColor:'#10d9a0',borderWidth:1,borderRadius:4},
        {label:'Saídas',data:sais,backgroundColor:'rgba(255,77,106,.65)',borderColor:'#ff4d6a',borderWidth:1,borderRadius:4}
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{labels:{font:{size:10}}},
        tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}},
      scales:{
        x:{ticks:{font:{size:9}},grid:{color:'#252535'}},
        y:{ticks:{font:{size:9},callback:v=>v>=1000?'R$'+(v/1000).toFixed(0)+'k':'R$'+v},grid:{color:'#252535'}}
      }
    }
  });
}

function renderChartCat(){
  const now = new Date();
  const mTx = tx.filter(t=>{
    const d = new Date(t.date+'T12:00:00');
    return d.getMonth()===now.getMonth() && d.getFullYear()===now.getFullYear() && t.type==='saida';
  });
  if(charts.cat) charts.cat.destroy();
  const ctx = document.getElementById('chart-cat').getContext('2d');
  if(mTx.length===0){ ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height); return; }

  const cMap={};
  mTx.forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  const keys=Object.keys(cMap);
  charts.cat = new Chart(ctx,{
    type:'doughnut',
    data:{
      labels:keys.map(k=>(CAT[k]?.e||'')+(CAT[k]?.l||k)),
      datasets:[{data:keys.map(k=>cMap[k]),backgroundColor:keys.map(k=>CAT[k]?.c||'#6b7280'),borderColor:'#161621',borderWidth:2,hoverOffset:6}]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{position:'bottom',labels:{font:{size:9},boxWidth:8,padding:6}},
        tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}
      }
    }
  });
}

function renderDueDates(){
  const el = document.getElementById('due-list');
  const now = new Date(); now.setHours(0,0,0,0);
  const horizon = new Date(now); horizon.setDate(horizon.getDate()+14);
  const upcoming = tx.filter(t=>{
    if(t.type!=='saida'||!t.dueDate||t.status==='pago') return false;
    const due = new Date(t.dueDate+'T12:00:00');
    return due <= horizon;
  }).sort((a,b)=>new Date(a.dueDate)-new Date(b.dueDate));

  if(upcoming.length===0){
    el.innerHTML='<div class="empty-state"><div class="empty-icon">✅</div><p>Nenhum vencimento próximo (14 dias)</p></div>';
    return;
  }
  el.innerHTML = upcoming.slice(0,6).map(t=>{
    const due = new Date(t.dueDate+'T12:00:00');
    const diff = Math.ceil((due-now)/86400000);
    const cat = CAT[t.category]||CAT.outros;
    let cls='', lbl='';
    if(diff<0){ cls='overdue'; lbl=`Venceu há ${Math.abs(diff)}d`; }
    else if(diff<=3){ cls='overdue'; lbl=diff===0?'Vence hoje':`Vence em ${diff}d`; }
    else{ lbl=`Vence em ${diff} dias`; }
    return `<div class="due-item ${cls}">
      <div><div class="due-desc">${cat.e} ${t.description}</div><div class="due-date-label">${lbl} • ${fmtDate(t.dueDate)}</div></div>
      <div class="due-amount">${fmtR(t.amount)}</div>
    </div>`;
  }).join('');
}

function renderInsights(){
  const el = document.getElementById('insights-list');
  if(tx.length===0){
    el.innerHTML='<div class="empty-state"><p>Adicione transações para ver insights</p></div>';
    return;
  }
  const now = new Date();
  const thisMo = tx.filter(t=>{ const d=new Date(t.date+'T12:00:00'); return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear(); });
  const lastMo = tx.filter(t=>{ const d=new Date(t.date+'T12:00:00'); const lm=new Date(now.getFullYear(),now.getMonth()-1,1); return d.getMonth()===lm.getMonth()&&d.getFullYear()===lm.getFullYear(); });
  const ent = thisMo.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = thisMo.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const lastSai = lastMo.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);

  const items=[];

  // Maior categoria
  const cMap={};
  thisMo.filter(t=>t.type==='saida').forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  const top = Object.entries(cMap).sort((a,b)=>b[1]-a[1])[0];
  if(top){ const ci=CAT[top[0]]||CAT.outros; items.push({i:ci.e,t:`Maior gasto deste mês: <strong>${ci.l}</strong> com <strong>${fmtR(top[1])}</strong>.`}); }

  // Saldo do mês
  if(ent>0){
    const taxa = (ent-sai)/ent*100;
    if(taxa<0) items.push({i:'⚠️',t:`Você gastou <strong>${fmtR(Math.abs(ent-sai))}</strong> além das suas entradas este mês.`});
    else items.push({i:'🎯',t:`Taxa de poupança este mês: <strong>${taxa.toFixed(1)}%</strong> da sua renda.`});
  }

  // Comparação mês anterior
  if(lastSai>0&&sai>0){
    const diff=(sai-lastSai)/lastSai*100;
    if(diff>5) items.push({i:'📈',t:`Seus gastos estão <strong>${diff.toFixed(1)}% maiores</strong> que no mês passado.`});
    else if(diff<-5) items.push({i:'📉',t:`Ótimo! Gastos <strong>${Math.abs(diff).toFixed(1)}% menores</strong> que no mês passado.`});
  }

  // Pendentes
  const pend = tx.filter(t=>t.type==='saida'&&t.status==='pendente');
  if(pend.length>0){
    const total=pend.reduce((s,t)=>s+t.amount,0);
    items.push({i:'⏳',t:`<strong>${pend.length} conta(s) pendente(s)</strong> totalizando <strong>${fmtR(total)}</strong>.`});
  }

  if(items.length===0){ el.innerHTML='<div class="empty-state"><p>Continue registrando para ver insights</p></div>'; return; }
  el.innerHTML=items.map(i=>`<div class="insight-item"><span class="insight-icon">${i.i}</span><span class="insight-text">${i.t}</span></div>`).join('');
}

/* ==================== EXTRATO ==================== */
function updateMonthLabel(){
  document.getElementById('month-label').textContent = MONTHS_S[exMonth.getMonth()]+' '+exMonth.getFullYear();
}

function getFiltered(){
  return tx.filter(t=>{
    const d = new Date(t.date+'T12:00:00');
    if(d.getMonth()!==exMonth.getMonth()||d.getFullYear()!==exMonth.getFullYear()) return false;
    if(fType!=='todos'&&t.type!==fType) return false;
    if(fCat&&t.category!==fCat) return false;
    if(fQ&&!t.description.toLowerCase().includes(fQ.toLowerCase())) return false;
    return true;
  });
}

function renderExtrato(){
  updateMonthLabel();
  const filtered = getFiltered();
  const ent = filtered.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = filtered.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const bal = ent-sai;
  document.getElementById('ext-ent').textContent = fmtR(ent);
  document.getElementById('ext-sai').textContent = fmtR(sai);
  const bEl = document.getElementById('ext-bal');
  bEl.textContent = fmtR(bal);
  bEl.className = 'kpi-value sm '+(bal>=0?'gold':'red');

  const el = document.getElementById('tx-list');
  if(filtered.length===0){
    el.innerHTML='<div class="empty-state"><div class="empty-icon">📭</div><p>Nenhuma transação encontrada</p></div>';
    return;
  }

  const sorted = [...filtered].sort((a,b)=>new Date(b.date)-new Date(a.date));
  const groups={};
  sorted.forEach(t=>{ if(!groups[t.date]) groups[t.date]=[]; groups[t.date].push(t); });

  let html='';
  Object.entries(groups).sort((a,b)=>new Date(b[0])-new Date(a[0])).forEach(([date,items])=>{
    html += `<div class="tx-date-group">${fmtDateFull(date)}</div>`;
    items.forEach(t=>{
      const cat = CAT[t.category]||CAT.outros;
      const sign = t.type==='entrada'?'+':'−';
      const badge = t.type==='saida'?`<span class="tx-badge ${t.status||'pago'}">${t.status==='pendente'?'Pendente':'Pago'}</span>`:'';
      html += `<div class="tx-item">
        <div class="tx-cat-icon" style="background:${cat.c}1f">${cat.e}</div>
        <div class="tx-info">
          <div class="tx-desc">${t.description}</div>
          <div class="tx-meta"><span>${cat.l}</span>${badge}${t.notes?`<span style="color:var(--text3)">• ${t.notes}</span>`:''}</div>
        </div>
        <div class="tx-right">
          <div class="tx-amount ${t.type}">${sign} ${fmtR(t.amount)}</div>
          <div class="tx-actions">
            <button class="tx-act-btn edit" data-id="${t.id}" title="Editar">✏️</button>
            <button class="tx-act-btn del" data-id="${t.id}" title="Apagar">🗑️</button>
          </div>
        </div>
      </div>`;
    });
  });
  el.innerHTML=html;

  el.querySelectorAll('.tx-act-btn.edit').forEach(b=>b.addEventListener('click',()=>openEdit(parseInt(b.dataset.id))));
  el.querySelectorAll('.tx-act-btn.del').forEach(b=>b.addEventListener('click',()=>openDel(parseInt(b.dataset.id))));
}

function buildCatChips(){
  const el = document.getElementById('cat-chips');
  let html = '<button class="filter-chip active" data-fcat="all">Todas</button>';
  Object.entries(CAT).forEach(([k,v])=>{ html+=`<button class="filter-chip" data-fcat="${k}">${v.e} ${v.l}</button>`; });
  el.innerHTML=html;
  el.querySelectorAll('.filter-chip').forEach(b=>{
    b.addEventListener('click',()=>{
      el.querySelectorAll('.filter-chip').forEach(x=>x.classList.remove('active'));
      b.classList.add('active');
      fCat = b.dataset.fcat==='all'?null:b.dataset.fcat;
      renderExtrato();
    });
  });
}

/* ==================== RELATÓRIOS ==================== */
function renderRelatorio(){
  const start = document.getElementById('r-start').value;
  const end = document.getElementById('r-end').value;
  if(!start||!end){ toast('Selecione as datas','error'); return; }

  rFiltered = tx.filter(t=>t.date>=start&&t.date<=end);
  const ent = rFiltered.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = rFiltered.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const res = ent-sai;

  document.getElementById('r-ent').textContent=fmtR(ent);
  document.getElementById('r-sai').textContent=fmtR(sai);
  const rEl=document.getElementById('r-res');
  rEl.textContent=fmtR(res);
  rEl.className='kpi-value '+(res>=0?'gold':'red');
  document.getElementById('report-content').style.display='block';

  renderLinha(start,end);
  renderPizza(rFiltered);
  renderBreakdown(rFiltered);
}

function renderLinha(start,end){
  const sorted=[...rFiltered].sort((a,b)=>new Date(a.date)-new Date(b.date));
  const dateMap={};
  sorted.forEach(t=>{ dateMap[t.date]=(dateMap[t.date]||0)+(t.type==='entrada'?t.amount:-t.amount); });
  const dates=Object.keys(dateMap).sort();
  let run=0; const labels=[],vals=[];
  dates.forEach(d=>{ run+=dateMap[d]; labels.push(fmtDate(d)); vals.push(run); });

  if(charts.linha) charts.linha.destroy();
  const ctx=document.getElementById('r-linha').getContext('2d');
  if(!labels.length) return;
  charts.linha=new Chart(ctx,{
    type:'line',
    data:{labels,datasets:[{label:'Saldo',data:vals,borderColor:'#daa520',backgroundColor:'rgba(218,165,32,.07)',borderWidth:2,pointRadius:3,pointBackgroundColor:'#daa520',fill:true,tension:.3}]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}},
      scales:{
        x:{ticks:{font:{size:9},maxTicksLimit:8},grid:{color:'#252535'}},
        y:{ticks:{font:{size:9},callback:v=>v>=1000?'R$'+(v/1000).toFixed(0)+'k':'R$'+v},grid:{color:'#252535'}}
      }
    }
  });
}

function renderPizza(filtered){
  const cMap={};
  filtered.filter(t=>t.type==='saida').forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  if(charts.pizza) charts.pizza.destroy();
  const ctx=document.getElementById('r-pizza').getContext('2d');
  if(!Object.keys(cMap).length) return;
  const keys=Object.keys(cMap);
  charts.pizza=new Chart(ctx,{
    type:'doughnut',
    data:{labels:keys.map(k=>(CAT[k]?.e||'')+' '+(CAT[k]?.l||k)),
      datasets:[{data:keys.map(k=>cMap[k]),backgroundColor:keys.map(k=>CAT[k]?.c||'#6b7280'),borderColor:'#161621',borderWidth:2,hoverOffset:6}]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{font:{size:9},boxWidth:8,padding:6}},
        tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}}}
  });
}

function renderBreakdown(filtered){
  const cMap={};
  filtered.filter(t=>t.type==='saida').forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  const total=Object.values(cMap).reduce((s,v)=>s+v,0);
  const sorted=Object.entries(cMap).sort((a,b)=>b[1]-a[1]);
  const el=document.getElementById('cat-breakdown');
  if(!sorted.length){ el.innerHTML='<div class="empty-state"><p>Nenhuma despesa no período</p></div>'; return; }
  el.innerHTML=sorted.map(([k,v])=>{
    const cat=CAT[k]||CAT.outros;
    const pct=total>0?(v/total*100).toFixed(1):0;
    return `<div class="cat-row">
      <div class="cat-row-icon">${cat.e}</div>
      <div class="cat-row-info">
        <div class="cat-row-label"><span>${cat.l}</span><span class="cat-val">${fmtR(v)} <span style="color:var(--text3);font-family:DM Sans;font-size:.72rem;font-weight:400">(${pct}%)</span></span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${cat.c}"></div></div>
      </div>
    </div>`;
  }).join('');
}

/* ==================== CAT GRID ==================== */
function buildCatGrid(gridId, selected, onSel){
  const el=document.getElementById(gridId);
  el.innerHTML=Object.entries(CAT).map(([k,v])=>`
    <div class="cat-opt ${k===selected?'sel':''}" data-cat="${k}">
      <span class="ce">${v.e}</span><span class="cn">${v.l}</span>
    </div>`).join('');
  el.querySelectorAll('.cat-opt').forEach(opt=>{
    opt.addEventListener('click',()=>{
      el.querySelectorAll('.cat-opt').forEach(x=>x.classList.remove('sel'));
      opt.classList.add('sel');
      onSel(opt.dataset.cat);
    });
  });
}

/* ==================== ADD MODAL ==================== */
function openAdd(){
  aType='entrada'; aCat='salario'; aStatus='pago';
  document.getElementById('a-desc').value='';
  document.getElementById('a-val').value='';
  document.getElementById('a-notes').value='';
  document.getElementById('a-due').value='';
  document.getElementById('a-date').value=new Date().toISOString().split('T')[0];
  updateAddUI();
  buildCatGrid('cg-add',aCat,c=>{aCat=c;});
  document.getElementById('add-modal').classList.add('open');
  setTimeout(()=>document.getElementById('a-desc').focus(),300);
}
function closeAdd(){ document.getElementById('add-modal').classList.remove('open'); }

function updateAddUI(){
  document.getElementById('a-ent').className='type-btn'+(aType==='entrada'?' act-entrada':'');
  document.getElementById('a-sai').className='type-btn'+(aType==='saida'?' act-saida':'');
  document.getElementById('a-due-g').style.display=aType==='saida'?'block':'none';
  document.getElementById('a-status-g').style.display=aType==='saida'?'block':'none';
  document.getElementById('a-pago').className='status-btn'+(aStatus==='pago'?' act-pago':'');
  document.getElementById('a-pend').className='status-btn'+(aStatus==='pendente'?' act-pendente':'');
  aCat = aType==='entrada'?'salario':'outros';
  buildCatGrid('cg-add',aCat,c=>{aCat=c;});
}

function submitAdd(){
  const desc=document.getElementById('a-desc').value.trim();
  const val=parseFloat(document.getElementById('a-val').value);
  const date=document.getElementById('a-date').value;
  const due=document.getElementById('a-due').value;
  const notes=document.getElementById('a-notes').value.trim();
  if(!desc){ toast('Informe uma descrição','error'); return; }
  if(!val||val<=0){ toast('Informe um valor válido','error'); return; }
  if(!date){ toast('Informe a data','error'); return; }

  tx.push({id:Date.now(),type:aType,category:aCat,description:desc,amount:val,date,dueDate:aType==='saida'?due:null,status:aType==='saida'?aStatus:'pago',notes});
  saveTx(); closeAdd(); renderAll();
  toast('Transação adicionada!','success');
}

/* ==================== EDIT MODAL ==================== */
function openEdit(id){
  const t=tx.find(t=>t.id===id);
  if(!t) return;
  eType=t.type; eCat=t.category||'outros'; eStatus=t.status||'pago';
  document.getElementById('e-id').value=id;
  document.getElementById('e-desc').value=t.description;
  document.getElementById('e-val').value=t.amount;
  document.getElementById('e-date').value=t.date;
  document.getElementById('e-due').value=t.dueDate||'';
  document.getElementById('e-notes').value=t.notes||'';
  updateEditUI();
  buildCatGrid('cg-edit',eCat,c=>{eCat=c;});
  document.getElementById('edit-modal').classList.add('open');
}
function closeEdit(){ document.getElementById('edit-modal').classList.remove('open'); }

function updateEditUI(){
  document.getElementById('e-ent').className='type-btn'+(eType==='entrada'?' act-entrada':'');
  document.getElementById('e-sai').className='type-btn'+(eType==='saida'?' act-saida':'');
  document.getElementById('e-due-g').style.display=eType==='saida'?'block':'none';
  document.getElementById('e-status-g').style.display=eType==='saida'?'block':'none';
  document.getElementById('e-pago').className='status-btn'+(eStatus==='pago'?' act-pago':'');
  document.getElementById('e-pend').className='status-btn'+(eStatus==='pendente'?' act-pendente':'');
}

function submitEdit(){
  const id=parseInt(document.getElementById('e-id').value);
  const desc=document.getElementById('e-desc').value.trim();
  const val=parseFloat(document.getElementById('e-val').value);
  const date=document.getElementById('e-date').value;
  const due=document.getElementById('e-due').value;
  const notes=document.getElementById('e-notes').value.trim();
  if(!desc){ toast('Informe uma descrição','error'); return; }
  if(!val||val<=0){ toast('Informe um valor válido','error'); return; }
  if(!date){ toast('Informe a data','error'); return; }
  const idx=tx.findIndex(t=>t.id===id);
  if(idx===-1) return;
  tx[idx]={...tx[idx],type:eType,category:eCat,description:desc,amount:val,date,dueDate:eType==='saida'?due:null,status:eType==='saida'?eStatus:'pago',notes};
  saveTx(); closeEdit(); renderAll();
  toast('Transação atualizada!','success');
}

/* ==================== DELETE ==================== */
function openDel(id){ delId=id; document.getElementById('del-modal').classList.add('open'); }
function closeDel(){ delId=null; document.getElementById('del-modal').classList.remove('open'); }
function confirmDel(){
  if(delId===null) return;
  tx=tx.filter(t=>t.id!==delId);
  saveTx(); closeDel(); renderAll();
  toast('Transação removida','info');
}

/* ==================== EXPORT ==================== */
function exportCSV(){
  const data = rFiltered.length?rFiltered:tx;
  const hdr=['Data','Tipo','Categoria','Descrição','Valor','Vencimento','Status','Notas'];
  const rows=data.map(t=>[
    fmtDate(t.date), t.type==='entrada'?'Entrada':'Saída',
    CAT[t.category]?.l||t.category||'', t.description,
    t.amount.toFixed(2).replace('.',','),
    t.dueDate?fmtDate(t.dueDate):'',
    t.status==='pendente'?'Pendente':'Pago',
    t.notes||''
  ]);
  const csv=[hdr,...rows].map(r=>r.map(v=>`"${v}"`).join(';')).join('\n');
  const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url; a.download=`financas_${new Date().toISOString().split('T')[0]}.csv`; a.click();
  URL.revokeObjectURL(url);
  toast('CSV exportado!','success');
}

/* ==================== LISTENERS ==================== */
function setupListeners(){
  // Tabs
  document.querySelectorAll('.tab-btn').forEach(b=>b.addEventListener('click',()=>switchTab(b.dataset.tab)));
  // FAB
  document.getElementById('fab').addEventListener('click',openAdd);
  // Add modal
  document.getElementById('add-close').addEventListener('click',closeAdd);
  document.getElementById('add-modal').addEventListener('click',e=>{if(e.target===e.currentTarget)closeAdd();});
  document.getElementById('a-ent').addEventListener('click',()=>{aType='entrada';updateAddUI();});
  document.getElementById('a-sai').addEventListener('click',()=>{aType='saida';updateAddUI();});
  document.getElementById('a-pago').addEventListener('click',()=>{aStatus='pago';document.getElementById('a-pago').className='status-btn act-pago';document.getElementById('a-pend').className='status-btn';});
  document.getElementById('a-pend').addEventListener('click',()=>{aStatus='pendente';document.getElementById('a-pago').className='status-btn';document.getElementById('a-pend').className='status-btn act-pendente';});
  document.getElementById('a-submit').addEventListener('click',submitAdd);
  // Edit modal
  document.getElementById('edit-close').addEventListener('click',closeEdit);
  document.getElementById('edit-modal').addEventListener('click',e=>{if(e.target===e.currentTarget)closeEdit();});
  document.getElementById('e-ent').addEventListener('click',()=>{eType='entrada';updateEditUI();buildCatGrid('cg-edit',eCat,c=>{eCat=c;});});
  document.getElementById('e-sai').addEventListener('click',()=>{eType='saida';updateEditUI();buildCatGrid('cg-edit',eCat,c=>{eCat=c;});});
  document.getElementById('e-pago').addEventListener('click',()=>{eStatus='pago';document.getElementById('e-pago').className='status-btn act-pago';document.getElementById('e-pend').className='status-btn';});
  document.getElementById('e-pend').addEventListener('click',()=>{eStatus='pendente';document.getElementById('e-pago').className='status-btn';document.getElementById('e-pend').className='status-btn act-pendente';});
  document.getElementById('e-submit').addEventListener('click',submitEdit);
  // Delete
  document.getElementById('del-close').addEventListener('click',closeDel);
  document.getElementById('del-cancel').addEventListener('click',closeDel);
  document.getElementById('del-confirm').addEventListener('click',confirmDel);
  document.getElementById('del-modal').addEventListener('click',e=>{if(e.target===e.currentTarget)closeDel();});
  // Month nav
  document.getElementById('prev-month').addEventListener('click',()=>{exMonth=new Date(exMonth.getFullYear(),exMonth.getMonth()-1,1);renderExtrato();});
  document.getElementById('next-month').addEventListener('click',()=>{exMonth=new Date(exMonth.getFullYear(),exMonth.getMonth()+1,1);renderExtrato();});
  // Type filters
  document.querySelectorAll('[data-ftype]').forEach(b=>{
    b.addEventListener('click',()=>{
      document.querySelectorAll('[data-ftype]').forEach(x=>x.classList.remove('active'));
      b.classList.add('active'); fType=b.dataset.ftype; renderExtrato();
    });
  });
  // Search
  document.getElementById('search-in').addEventListener('input',e=>{fQ=e.target.value;renderExtrato();});
  // Relatório
  document.getElementById('btn-gerar').addEventListener('click',renderRelatorio);
  document.getElementById('btn-export').addEventListener('click',exportCSV);
  // Keyboard
  document.addEventListener('keydown',e=>{
    if(e.key==='Escape'){closeAdd();closeEdit();closeDel();}
  });
}

/* ==================== UTILS ==================== */
function fmtR(v){
  return new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(v);
}
function fmtDate(s){
  if(!s) return '';
  const [y,m,d]=s.split('-');
  return `${d}/${m}/${y}`;
}
function fmtDateFull(s){
  if(!s) return '';
  const d=new Date(s+'T12:00:00');
  return d.toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'});
}
function toast(msg,type='info'){
  const el=document.getElementById('notifs');
  const t=document.createElement('div');
  const icons={success:'✅',error:'❌',info:'💡'};
  t.className=`toast ${type}`;
  t.innerHTML=`<span>${icons[type]||'•'}</span><span>${msg}</span>`;
  el.appendChild(t);
  setTimeout(()=>t.remove(),4100);
}
