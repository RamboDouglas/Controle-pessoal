  document.getElementById('e-pago').addEventListener('click',()=>{eStatus='pago';document.getElementById('e-pago').className='status-btn act-pago';document.getElementById('e-pend').className='status-btn';document.getElementById('e-pago').setAttribute('aria-pressed','true');document.getElementById('e-pend').setAttribute('aria-pressed','false');});
