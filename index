<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#09090f">
<meta name="description" content="Controle pessoal de gastos e entradas: saldo, extrato mensal, vencimentos e relatorios.">
<title>Controle Financeiro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root {
  --bg:#09090f;--surface:#111119;--card:#161621;--card2:#1d1d2e;
  --border:#252535;--border2:#2e2e42;
  --gold:#daa520;--gold2:#f0c040;
  --success:#10d9a0;--danger:#ff4d6a;--warning:#fbbf24;--info:#818cf8;
  /* text2/text3 clareados: antes 5.2:1 e 2.7:1 sobre --card; agora 6.6:1 e 5.3:1 (WCAG AA) */
  --text:#e2e2f0;--text2:#9a9ab8;--text3:#8a8aa4;
  --r:12px;--r2:8px;--shadow:0 4px 24px rgba(0,0,0,.4);--tr:.2s ease;
  /* escala de espacamento (densidade dashboard) */
  --s1:.5rem;--s2:.75rem;--s3:1rem;--s4:1.5rem;--s5:2rem;
  --tap:44px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:16px;padding-bottom:env(safe-area-inset-bottom)}
h1,h2,h3,.syne{font-family:'Syne',sans-serif}

/* foco visivel para navegacao por teclado */
:where(a,button,input,select,textarea,[tabindex]):focus-visible{outline:2px solid var(--gold2);outline-offset:2px}

/* respeita quem pediu menos movimento no sistema */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}

/* icones SVG: herdam a cor do texto */
.ic{width:1.15em;height:1.15em;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;display:inline-block;vertical-align:-.2em}

/* pular para o conteudo */
.skip-link{position:absolute;left:-9999px;z-index:3000;padding:.7rem 1rem;background:var(--gold);color:#000;border-radius:var(--r2);font-weight:700;font-size:.9rem}
.skip-link:focus{left:1rem;top:1rem}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--surface)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}

/* LAYOUT */
.wrap{max-width:1080px;margin:0 auto;padding:0 1rem}

/* HEADER */
.app-header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 0 .8rem;border-bottom:1px solid var(--border)}
.logo{display:flex;align-items:center;gap:.6rem}
.logo-icon{width:36px;height:36px;background:linear-gradient(135deg,var(--gold),#b8860b);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#0a0a0f;flex-shrink:0}
.logo-icon .ic{width:20px;height:20px;stroke-width:2.2}
.logo h1{font-size:1.2rem;font-weight:700;letter-spacing:-.02em}
.logo span{color:var(--gold)}
.header-date{font-size:.8rem;color:var(--text2)}

/* TABS */
.tab-nav{display:flex;gap:.2rem;padding:.6rem 0;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.tab-nav::-webkit-scrollbar{display:none}
.tab-btn{display:flex;align-items:center;gap:.4rem;padding:.55rem .9rem;min-height:var(--tap);border:none;background:none;color:var(--text2);font-family:'DM Sans',sans-serif;font-size:.9rem;font-weight:500;cursor:pointer;border-radius:var(--r2);white-space:nowrap;transition:all var(--tr)}
@media (hover:hover){.tab-btn:hover{color:var(--text);background:var(--card)}}
.tab-btn:active{transform:scale(.97)}
.tab-btn.active{color:var(--gold);background:rgba(218,165,32,.1);font-weight:600}
.tab-content{display:none;padding:1.25rem 0 5rem;animation:fadeUp .25s ease}
.tab-content.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* CARDS */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1.1rem;margin-bottom:1.1rem}
.card-title{display:flex;align-items:center;gap:.45rem;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text2);margin-bottom:.9rem}

/* KPI GRID */
.kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin-bottom:1.1rem}
@media(min-width:600px){.kpi-grid{grid-template-columns:repeat(4,1fr)}}
.kpi-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1rem;position:relative;overflow:hidden}
.kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:var(--r) var(--r) 0 0}
.kpi-card.gold::before{background:var(--gold)}
.kpi-card.green::before{background:var(--success)}
.kpi-card.red::before{background:var(--danger)}
.kpi-card.purple::before{background:var(--info)}
.kpi-label{display:flex;align-items:center;gap:.35rem;font-size:.78rem;color:var(--text2);font-weight:500;margin-bottom:.4rem}
.kpi-value{font-family:'Syne',sans-serif;font-size:1.25rem;font-weight:700;letter-spacing:-.02em;line-height:1}
.kpi-value.gold{color:var(--gold)}
.kpi-value.green{color:var(--success)}
.kpi-value.red{color:var(--danger)}
.kpi-value.purple{color:var(--info)}
.kpi-sub{font-size:.75rem;color:var(--text3);margin-top:.3rem}

/* CHARTS ROW */
.charts-row{display:grid;grid-template-columns:1fr;gap:1.1rem;margin-bottom:1.1rem}
@media(min-width:680px){.charts-row{grid-template-columns:1.65fr 1fr}}
.chart-wrap{position:relative;height:200px}

/* INSIGHTS */
.insights-list{display:flex;flex-direction:column;gap:.55rem}
.insight-item{display:flex;align-items:flex-start;gap:.65rem;padding:.7rem;background:var(--card2);border-radius:var(--r2);border:1px solid var(--border)}
.insight-icon{flex-shrink:0;margin-top:.12rem;color:var(--gold);display:flex}
.insight-icon .ic{width:18px;height:18px}
.insight-text{font-size:.9rem;color:var(--text2);line-height:1.5}
.insight-text strong{color:var(--text)}

/* DUE DATES */
.due-list{display:flex;flex-direction:column;gap:.5rem}
.due-item{display:flex;align-items:center;justify-content:space-between;padding:.65rem .85rem;background:var(--card2);border-radius:var(--r2);border-left:3px solid var(--warning);border-top:1px solid var(--border);border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
.due-item.overdue{border-left-color:var(--danger)}
.due-item.safe{border-left-color:var(--success)}
.due-desc{display:flex;align-items:center;gap:.45rem;font-size:.9rem;font-weight:500}
.due-date-label{font-size:.75rem;color:var(--text2);margin-top:.15rem}
.due-amount{font-family:'Syne',sans-serif;font-size:.92rem;font-weight:700;color:var(--danger)}

/* EXTRATO */
.month-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:.9rem}
.mnav-btn{background:var(--card);border:1px solid var(--border);color:var(--text);width:var(--tap);height:var(--tap);border-radius:var(--r2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all var(--tr)}
.mnav-btn .ic{width:20px;height:20px}
@media (hover:hover){.mnav-btn:hover{border-color:var(--gold);color:var(--gold)}}
.mnav-btn:active{transform:scale(.94)}
.mnav-label{font-family:'Syne',sans-serif;font-size:1.05rem;font-weight:700;letter-spacing:-.01em}
.filters-row{display:flex;gap:.45rem;margin-bottom:.75rem;flex-wrap:wrap}
.search-wrap{flex:1;min-width:150px;position:relative;display:flex;align-items:center}
.search-wrap .ic{position:absolute;left:.8rem;width:17px;height:17px;color:var(--text3);pointer-events:none}
.search-in{width:100%;min-height:var(--tap);padding:.52rem .85rem .52rem 2.4rem;background:var(--card);border:1px solid var(--border);color:var(--text);border-radius:var(--r2);font-family:'DM Sans',sans-serif;font-size:1rem;transition:all var(--tr)}
.search-in::placeholder{color:var(--text3)}
.search-in:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(218,165,32,.12)}
.filter-chip{display:inline-flex;align-items:center;gap:.35rem;padding:.5rem .85rem;min-height:38px;background:var(--card);border:1px solid var(--border);color:var(--text2);border-radius:99px;font-family:'DM Sans',sans-serif;font-size:.82rem;font-weight:500;cursor:pointer;transition:all var(--tr);white-space:nowrap}
.filter-chip .ic{width:15px;height:15px}
@media (hover:hover){.filter-chip:hover:not(.active){border-color:var(--gold);color:var(--gold);background:rgba(218,165,32,.08)}}
/* ativo com preenchimento solido: nao se confunde com o hover */
.filter-chip.active{background:var(--gold);border-color:var(--gold);color:#0a0a0f;font-weight:700}
.filter-chip:active{transform:scale(.96)}

/* TRANSACTION ITEMS */
.tx-date-group{font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);padding:.7rem .9rem .35rem;border-bottom:1px solid var(--border)}
.tx-item{display:flex;align-items:center;gap:.85rem;padding:.85rem .9rem;border-bottom:1px solid var(--border);transition:background var(--tr)}
.tx-item:last-child{border-bottom:none}
.tx-item:hover{background:var(--card2)}
.tx-cat-icon{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.tx-cat-icon .ic{width:19px;height:19px}
.tx-info{flex:1;min-width:0}
.tx-desc{font-size:.95rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tx-meta{font-size:.78rem;color:var(--text2);margin-top:.15rem;display:flex;gap:.45rem;align-items:center;flex-wrap:wrap}
.tx-badge{display:inline-flex;align-items:center;gap:.25rem;font-size:.75rem;padding:.14rem .5rem;border-radius:99px;font-weight:600;letter-spacing:.02em}
.tx-badge .ic{width:13px;height:13px}
.tx-badge.pendente{background:rgba(251,191,36,.15);color:var(--warning)}
.tx-badge.pago{background:rgba(16,217,160,.1);color:var(--success)}
.tx-right{display:flex;flex-direction:column;align-items:flex-end;gap:.3rem}
.tx-amount{font-family:'Syne',sans-serif;font-size:.98rem;font-weight:700;white-space:nowrap}
.tx-amount.entrada{color:var(--success)}
.tx-amount.saida{color:var(--danger)}
/* acoes sempre visiveis: em tela de toque nao existe hover para revela-las */
.tx-actions{display:flex;gap:.4rem;opacity:1;transition:opacity var(--tr)}
.tx-act-btn{width:var(--tap);height:var(--tap);border:none;background:var(--surface);border-radius:9px;color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all var(--tr)}
.tx-act-btn .ic{width:17px;height:17px}
.tx-act-btn:active{transform:scale(.92)}
@media (hover:hover){
  /* so onde existe mouse elas se escondem ate a linha receber hover ou foco */
  .tx-actions{opacity:0}
  .tx-item:hover .tx-actions,.tx-item:focus-within .tx-actions{opacity:1}
  .tx-act-btn{width:32px;height:32px}
  .tx-act-btn.edit:hover{background:rgba(218,165,32,.2);color:var(--gold)}
  .tx-act-btn.del:hover{background:rgba(255,77,106,.2);color:var(--danger)}
}
.empty-state{text-align:center;padding:2.5rem 1rem;color:var(--text3)}
.empty-icon{margin-bottom:.6rem;display:flex;justify-content:center}
.empty-icon .ic{width:34px;height:34px;stroke-width:1.6}
.empty-state p{font-size:.95rem}

/* REPORT */
.report-row{display:flex;gap:.75rem;align-items:flex-end;flex-wrap:wrap;margin-bottom:1.1rem}
.report-row .fg{flex:1;min-width:120px;margin-bottom:0}
.cat-breakdown{display:flex;flex-direction:column;gap:.65rem}
.cat-row{display:flex;align-items:center;gap:.7rem}
.cat-row-icon{width:22px;display:flex;justify-content:center;flex-shrink:0;color:var(--text2)}
.cat-row-icon .ic{width:18px;height:18px}
.cat-row-info{flex:1}
.cat-row-label{font-size:.875rem;font-weight:500;display:flex;justify-content:space-between;gap:.5rem;margin-bottom:.3rem}
.cat-row-label .cat-val{color:var(--danger);font-family:'Syne',sans-serif;font-size:.875rem;white-space:nowrap}
.bar-track{height:5px;background:var(--border2);border-radius:99px;overflow:hidden}
.bar-fill{height:100%;border-radius:99px;transition:width .5s ease}

/* FORMS */
.fg{margin-bottom:.9rem}
.form-label{display:block;font-size:.78rem;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem}
.form-control{width:100%;min-height:var(--tap);padding:.65rem .85rem;background:var(--surface);border:1px solid var(--border2);color:var(--text);border-radius:var(--r2);font-family:'DM Sans',sans-serif;font-size:1rem;transition:all var(--tr)}
.form-control::placeholder{color:var(--text3)}
.form-control:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(218,165,32,.12)}
.form-control[aria-invalid="true"]{border-color:var(--danger)}
/* erro junto do campo, nao so num toast no canto */
.field-error{display:none;align-items:center;gap:.35rem;margin-top:.4rem;font-size:.82rem;color:var(--danger)}
.field-error .ic{width:15px;height:15px}
.field-error.show{display:flex}
.form-hint{font-size:.8rem;color:var(--text3);margin-top:.35rem}
input[type="date"]::-webkit-calendar-picker-indicator{filter:invert(.7);cursor:pointer}

/* TYPE TOGGLE */
.type-toggle{display:flex;gap:.45rem;margin-bottom:.9rem}
.type-btn{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.65rem;min-height:var(--tap);border:1px solid var(--border2);background:var(--surface);border-radius:var(--r2);color:var(--text2);font-family:'DM Sans',sans-serif;font-size:.9rem;font-weight:600;cursor:pointer;transition:all var(--tr)}
.type-btn:active{transform:scale(.97)}
.type-btn.act-entrada{background:rgba(16,217,160,.1);border-color:var(--success);color:var(--success)}
.type-btn.act-saida{background:rgba(255,77,106,.1);border-color:var(--danger);color:var(--danger)}

/* CATEGORY GRID */
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem;margin-bottom:.9rem}
.cat-opt{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;padding:.6rem .25rem;min-height:var(--tap);border:1px solid var(--border2);background:var(--surface);border-radius:var(--r2);color:var(--text2);cursor:pointer;transition:all var(--tr);text-align:center;font-family:'DM Sans',sans-serif}
@media (hover:hover){.cat-opt:hover{border-color:var(--gold)}}
.cat-opt:active{transform:scale(.95)}
.cat-opt.sel{border-color:var(--gold);background:rgba(218,165,32,.12);color:var(--gold)}
.cat-opt .ce{display:flex}
.cat-opt .ce .ic{width:20px;height:20px}
.cat-opt .cn{font-size:.75rem;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.cat-opt.sel .cn{color:var(--gold)}

/* STATUS TOGGLE */
.status-toggle{display:flex;gap:.45rem;margin-bottom:.9rem}
.status-btn{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.55rem;min-height:var(--tap);border:1px solid var(--border2);background:var(--surface);border-radius:var(--r2);color:var(--text2);font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:600;cursor:pointer;transition:all var(--tr)}
.status-btn:active{transform:scale(.97)}
.status-btn.act-pago{background:rgba(16,217,160,.1);border-color:var(--success);color:var(--success)}
.status-btn.act-pendente{background:rgba(251,191,36,.1);border-color:var(--warning);color:var(--warning)}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;padding:.7rem 1.2rem;min-height:var(--tap);border:none;border-radius:var(--r2);font-family:'DM Sans',sans-serif;font-size:.9rem;font-weight:600;cursor:pointer;transition:all var(--tr);white-space:nowrap}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--gold);color:#000;width:100%}
@media (hover:hover){.btn-primary:hover{background:var(--gold2);transform:translateY(-1px);box-shadow:0 4px 16px rgba(218,165,32,.3)}}
.btn-secondary{background:var(--card2);color:var(--text2);border:1px solid var(--border)}
.btn-secondary:hover{border-color:var(--border2);color:var(--text)}
.btn-danger{background:rgba(255,77,106,.1);color:var(--danger);border:1px solid rgba(255,77,106,.3)}
.btn-danger:hover{background:var(--danger);color:#fff}
.btn-sm{padding:.45rem .85rem;font-size:.85rem}

/* FAB */
.fab{position:fixed;bottom:calc(1.75rem + env(safe-area-inset-bottom));right:1.75rem;width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--gold),#b8860b);border:none;color:#0a0a0f;cursor:pointer;box-shadow:0 8px 24px rgba(218,165,32,.45);display:flex;align-items:center;justify-content:center;transition:all var(--tr);z-index:100}
.fab .ic{width:26px;height:26px;stroke-width:2.4}
@media (hover:hover){.fab:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 12px 32px rgba(218,165,32,.55)}}
.fab:active{transform:scale(.94)}

/* MODALS */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:500;align-items:flex-end;justify-content:center;backdrop-filter:blur(4px)}
.modal-overlay.open{display:flex;animation:overlayIn .2s ease}
@keyframes overlayIn{from{opacity:0}to{opacity:1}}
.modal-panel{background:var(--card);border-radius:var(--r) var(--r) 0 0;border:1px solid var(--border);border-bottom:none;width:100%;max-width:500px;max-height:92vh;overflow-y:auto;padding:1.4rem 1.4rem calc(1.4rem + env(safe-area-inset-bottom));animation:slideUp .3s ease}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@media(min-width:680px){
  .modal-overlay{align-items:center}
  .modal-panel{border-radius:var(--r);border:1px solid var(--border);animation:scaleIn .2s ease}
  @keyframes scaleIn{from{transform:scale(.95);opacity:0}to{transform:scale(1);opacity:1}}
}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.1rem}
.modal-title{font-family:'Syne',sans-serif;font-size:1.05rem;font-weight:700}
.modal-close{width:var(--tap);height:var(--tap);border:none;background:var(--surface);border-radius:9px;color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all var(--tr);flex-shrink:0}
.modal-close .ic{width:19px;height:19px}
@media (hover:hover){.modal-close:hover{color:var(--text);background:var(--border)}}
.modal-close:active{transform:scale(.92)}
.modal-overlay.centered{align-items:center}
.modal-panel.compact{max-width:360px;border-radius:var(--r);border:1px solid var(--border);animation:scaleIn .2s ease}
.confirm-text{font-size:.95rem;color:var(--text2);margin-bottom:1.1rem;line-height:1.55}
.confirm-btns{display:flex;gap:.65rem}
.confirm-btns .btn{flex:1}

/* TOASTS */
.notif-wrap{position:fixed;top:1rem;right:1rem;z-index:2000;display:flex;flex-direction:column;gap:.45rem;pointer-events:none}
.toast{padding:.8rem 1rem;border-radius:var(--r2);font-size:.9rem;font-weight:500;box-shadow:var(--shadow);animation:toastIn .25s ease,toastOut .25s ease 3.75s forwards;display:flex;align-items:center;gap:.5rem;max-width:320px}
.toast .ic{width:17px;height:17px}
.toast.success{background:var(--card2);border:1px solid var(--success);color:var(--success)}
.toast.error{background:var(--card2);border:1px solid var(--danger);color:var(--danger)}
.toast.info{background:var(--card2);border:1px solid var(--gold);color:var(--gold)}
@keyframes toastIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:translateX(0)}}
@keyframes toastOut{from{opacity:1}to{opacity:0;transform:translateX(16px)}}

.export-row{display:flex;justify-content:flex-end;gap:.65rem;margin-top:.5rem}
.mini-kpi{grid-template-columns:repeat(3,1fr) !important}
.kpi-card.sm{padding:.7rem .6rem}
/* tres colunas em 390px nao comportam "R$ 5.050,50" em tamanho fixo: escala com a largura */
.kpi-value.sm{font-size:clamp(.85rem,3.7vw,1.05rem);letter-spacing:-.03em}
</style>
</head>
<body>

<a class="skip-link" href="#conteudo">Pular para o conteudo</a>

<!-- Biblioteca de icones: SVG de traco, herda a cor do texto. Substituiu os emojis,
     que mudavam de desenho a cada sistema operacional e eram lidos em voz alta
     por leitores de tela ("saco de dinheiro Saldo Total"). -->
