  document.querySelectorAll('[data-ftype]').forEach(b=>{
    b.addEventListener('click',()=>{
      document.querySelectorAll('[data-ftype]').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false');});
      b.classList.add('active'); b.setAttribute('aria-pressed','true');
      fType=b.dataset.ftype; renderExtrato();
