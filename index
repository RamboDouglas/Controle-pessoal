    </div>
    <p class="confirm-text" id="del-desc">Tem certeza que deseja apagar esta transação? Essa ação não pode ser desfeita.</p>
    <div class="confirm-btns">
      <button class="btn btn-secondary" id="del-cancel">Cancelar</button>
      <button class="btn btn-danger" id="del-confirm"><svg class="ic" aria-hidden="true"><use href="#i-trash"/></svg> Apagar</button>
    </div>
  </div>
</div>

<!-- NOTIFICATIONS -->
<div class="notif-wrap" id="notifs" role="status" aria-live="polite" aria-atomic="false"></div>

<script>
/* ==================== CONSTANTS ==================== */
const CAT = {
  salario:      {l:'Salário',     i:'banknote', c:'#10d9a0'},
  freelance:    {l:'Freelance',   i:'laptop',   c:'#818cf8'},
  investimentos:{l:'Investim.',   i:'trend-up', c:'#a78bfa'},
  alimentacao:  {l:'Alimentação', i:'food',     c:'#f97316'},
  transporte:   {l:'Transporte',  i:'car',      c:'#06b6d4'},
  moradia:      {l:'Moradia',     i:'home',     c:'#94a3b8'},
  saude:        {l:'Saúde',       i:'pill',     c:'#ec4899'},
  educacao:     {l:'Educação',    i:'cap',      c:'#3b82f6'},
  lazer:        {l:'Lazer',       i:'game',     c:'#fbbf24'},
  contas:       {l:'Contas',      i:'zap',      c:'#a8b3c4'},
  vestuario:    {l:'Vestuário',   i:'shirt',    c:'#f43f5e'},
  outros:       {l:'Outros',      i:'package',  c:'#8b93a3'},
};

/* Texto do usuario vai para innerHTML em varios pontos: escapar evita que uma
   descricao contendo "<" quebre a lista ou injete marcacao. */
function esc(v){
  return String(v == null ? '' : v).replace(/[&<>"']/g, c => (
    {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]
  ));
}
/* Referencia um simbolo do sprite SVG declarado no topo do body. */
function icon(name, cls){
  return `<svg class="ic${cls ? ' ' + cls : ''}" aria-hidden="true"><use href="#i-${name}"/></svg>`;
}
/* Aceita "1250,90", "1.250,90" e "1250.90" - em pt-BR o separador decimal e a virgula. */
function parseVal(raw){
  const t = String(raw == null ? '' : raw).trim().replace(/R\$|\s/g, '');
  if(!t) return NaN;
  return t.includes(',') ? parseFloat(t.replace(/\./g, '').replace(',', '.')) : parseFloat(t);
}
function valToField(n){ return String(n).replace('.', ','); }

const MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const MONTHS_S = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

/* ==================== STATE ==================== */
let tx = [];
let exMonth = new Date();
let delId = null;
let aType = 'entrada', aCat = 'salario', aStatus = 'pago';
let eType = 'entrada', eCat = 'outros', eStatus = 'pago';
let fType = 'todos', fCat = null, fQ = '';
let rFiltered = [];
let charts = {};

/* ==================== INIT ==================== */
document.addEventListener('DOMContentLoaded', () => {
  Chart.defaults.color = '#9a9ab8';
  Chart.defaults.borderColor = '#252535';
  Chart.defaults.font.size = 12;
  loadTx();
  setDefaultDates();
  buildCatChips();
  setupListeners();
  document.getElementById('header-date').textContent = new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  switchTab('dashboard');
  renderAll();
});

function loadTx(){
  const s = localStorage.getItem('finapp_v3');
  tx = s ? JSON.parse(s) : [];
}
function saveTx(){ localStorage.setItem('finapp_v3', JSON.stringify(tx)); }

function setDefaultDates(){
  const today = new Date().toISOString().split('T')[0];
  const now = new Date();
  document.getElementById('a-date').value = today;
  document.getElementById('r-start').value = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0];
  document.getElementById('r-end').value = today;
}

function renderAll(){
  renderDashboard();
  renderExtrato();
}

/* ==================== TAB ==================== */
function switchTab(tab, moveFocus){
  document.querySelectorAll('.tab-btn').forEach(b => {
    const on = b.dataset.tab === tab;
    b.classList.toggle('active', on);
    b.setAttribute('aria-selected', on ? 'true' : 'false');
    b.tabIndex = on ? 0 : -1;          // uma unica parada de Tab na barra de abas
    if(on && moveFocus) b.focus();
  });
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById(`tab-${tab}`).classList.add('active');
  if(tab === 'dashboard') renderDashboard();
  if(tab === 'extrato') renderExtrato();
}

/* Setas navegam entre abas, como manda o padrao WAI-ARIA de tablist. */
function tabKeydown(e){
  const order = ['dashboard','extrato','relatorios'];
  const cur = order.indexOf(e.currentTarget.dataset.tab);
  let next = null;
  if(e.key === 'ArrowRight') next = (cur + 1) % order.length;
  else if(e.key === 'ArrowLeft') next = (cur - 1 + order.length) % order.length;
  else if(e.key === 'Home') next = 0;
  else if(e.key === 'End') next = order.length - 1;
  if(next === null) return;
  e.preventDefault();
  switchTab(order[next], true);
}

/* ==================== DASHBOARD ==================== */
function renderDashboard(){
  renderKPIs();
  renderChartMensal();
  renderChartCat();
  renderDueDates();
  renderInsights();
}

function renderKPIs(){
  const now = new Date();
  const mTx = tx.filter(t => {
    const d = new Date(t.date+'T12:00:00');
    return d.getMonth()===now.getMonth() && d.getFullYear()===now.getFullYear();
  });
  const ent = mTx.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = mTx.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const saldo = tx.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0)
              - tx.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const poupanca = ent > 0 ? Math.max(0,(ent-sai)/ent*100) : null;
  const ml = MONTHS_S[now.getMonth()]+' '+now.getFullYear();

  document.getElementById('kpi-saldo').textContent = fmtR(saldo);
  document.getElementById('kpi-saldo').className = 'kpi-value '+(saldo>=0?'gold':'red');
  document.getElementById('kpi-entradas').textContent = fmtR(ent);
  document.getElementById('kpi-saidas').textContent = fmtR(sai);
  document.getElementById('kpi-poupanca').textContent = poupanca !== null ? poupanca.toFixed(1)+'%' : '—';
  document.getElementById('kpi-ent-sub').textContent = ml;
  document.getElementById('kpi-sai-sub').textContent = ml;
}

function renderChartMensal(){
  const now = new Date();
  const labels=[], ents=[], sais=[];
  for(let i=5;i>=0;i--){
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    labels.push(MONTHS_S[d.getMonth()]+'/'+String(d.getFullYear()).slice(2));
    const mTx = tx.filter(t=>{
      const td = new Date(t.date+'T12:00:00');
      return td.getMonth()===d.getMonth() && td.getFullYear()===d.getFullYear();
    });
    ents.push(mTx.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0));
    sais.push(mTx.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0));
  }
  if(charts.mensal) charts.mensal.destroy();
  const ctx = document.getElementById('chart-mensal').getContext('2d');
  charts.mensal = new Chart(ctx,{
    type:'bar',
    data:{
      labels,
      datasets:[
        {label:'Entradas',data:ents,backgroundColor:'rgba(16,217,160,.65)',borderColor:'#10d9a0',borderWidth:1,borderRadius:4},
        {label:'Saídas',data:sais,backgroundColor:'rgba(255,77,106,.65)',borderColor:'#ff4d6a',borderWidth:1,borderRadius:4}
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{labels:{font:{size:10}}},
        tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}},
      scales:{
        x:{ticks:{font:{size:9}},grid:{color:'#252535'}},
        y:{ticks:{font:{size:9},callback:v=>v>=1000?'R$'+(v/1000).toFixed(0)+'k':'R$'+v},grid:{color:'#252535'}}
      }
    }
  });
}

function renderChartCat(){
  const now = new Date();
  const mTx = tx.filter(t=>{
    const d = new Date(t.date+'T12:00:00');
    return d.getMonth()===now.getMonth() && d.getFullYear()===now.getFullYear() && t.type==='saida';
  });
  if(charts.cat) charts.cat.destroy();
  const ctx = document.getElementById('chart-cat').getContext('2d');
  if(mTx.length===0){ ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height); return; }

  const cMap={};
  mTx.forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  const keys=Object.keys(cMap);
  charts.cat = new Chart(ctx,{
    type:'doughnut',
    data:{
      labels:keys.map(k=>CAT[k]?.l||k),
      datasets:[{data:keys.map(k=>cMap[k]),backgroundColor:keys.map(k=>CAT[k]?.c||'#6b7280'),borderColor:'#161621',borderWidth:2,hoverOffset:6}]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{position:'bottom',labels:{font:{size:11},boxWidth:10,padding:8}},
        tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}
      }
    }
  });
}

function renderDueDates(){
  const el = document.getElementById('due-list');
  const now = new Date(); now.setHours(0,0,0,0);
  const horizon = new Date(now); horizon.setDate(horizon.getDate()+14);
  const upcoming = tx.filter(t=>{
    if(t.type!=='saida'||!t.dueDate||t.status==='pago') return false;
    const due = new Date(t.dueDate+'T12:00:00');
    return due <= horizon;
  }).sort((a,b)=>new Date(a.dueDate)-new Date(b.dueDate));

  if(upcoming.length===0){
    el.innerHTML=`<div class="empty-state"><div class="empty-icon">${icon('check-circle')}</div><p>Nenhum vencimento próximo (14 dias)</p></div>`;
    return;
  }
  el.innerHTML = upcoming.slice(0,6).map(t=>{
    const due = new Date(t.dueDate+'T12:00:00');
    const diff = Math.ceil((due-now)/86400000);
    const cat = CAT[t.category]||CAT.outros;
    let cls='', lbl='';
    if(diff<0){ cls='overdue'; lbl=`Venceu há ${Math.abs(diff)}d`; }
    else if(diff<=3){ cls='overdue'; lbl=diff===0?'Vence hoje':`Vence em ${diff}d`; }
    else{ lbl=`Vence em ${diff} dias`; }
    return `<div class="due-item ${cls}">
      <div><div class="due-desc">${icon(cat.i)} ${esc(t.description)}</div><div class="due-date-label">${lbl} • ${fmtDate(t.dueDate)}</div></div>
      <div class="due-amount">${fmtR(t.amount)}</div>
    </div>`;
  }).join('');
}

function renderInsights(){
  const el = document.getElementById('insights-list');
  if(tx.length===0){
    el.innerHTML='<div class="empty-state"><p>Adicione transações para ver insights</p></div>';
    return;
  }
  const now = new Date();
  const thisMo = tx.filter(t=>{ const d=new Date(t.date+'T12:00:00'); return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear(); });
  const lastMo = tx.filter(t=>{ const d=new Date(t.date+'T12:00:00'); const lm=new Date(now.getFullYear(),now.getMonth()-1,1); return d.getMonth()===lm.getMonth()&&d.getFullYear()===lm.getFullYear(); });
  const ent = thisMo.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = thisMo.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const lastSai = lastMo.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);

  const items=[];

  // Maior categoria
  const cMap={};
  thisMo.filter(t=>t.type==='saida').forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  const top = Object.entries(cMap).sort((a,b)=>b[1]-a[1])[0];
  if(top){ const ci=CAT[top[0]]||CAT.outros; items.push({i:ci.i,t:`Maior gasto deste mês: <strong>${ci.l}</strong> com <strong>${fmtR(top[1])}</strong>.`}); }

  // Saldo do mês
  if(ent>0){
    const taxa = (ent-sai)/ent*100;
    if(taxa<0) items.push({i:'alert',t:`Você gastou <strong>${fmtR(Math.abs(ent-sai))}</strong> além das suas entradas este mês.`});
    else items.push({i:'target',t:`Taxa de poupança este mês: <strong>${taxa.toFixed(1)}%</strong> da sua renda.`});
  }

  // Comparação mês anterior
  if(lastSai>0&&sai>0){
    const diff=(sai-lastSai)/lastSai*100;
    if(diff>5) items.push({i:'trend-up',t:`Seus gastos estão <strong>${diff.toFixed(1)}% maiores</strong> que no mês passado.`});
    else if(diff<-5) items.push({i:'trend-down',t:`Ótimo! Gastos <strong>${Math.abs(diff).toFixed(1)}% menores</strong> que no mês passado.`});
  }

  // Pendentes
  const pend = tx.filter(t=>t.type==='saida'&&t.status==='pendente');
  if(pend.length>0){
    const total=pend.reduce((s,t)=>s+t.amount,0);
    items.push({i:'clock',t:`<strong>${pend.length} conta(s) pendente(s)</strong> totalizando <strong>${fmtR(total)}</strong>.`});
  }

  if(items.length===0){ el.innerHTML='<div class="empty-state"><p>Continue registrando para ver insights</p></div>'; return; }
  el.innerHTML=items.map(i=>`<div class="insight-item"><span class="insight-icon">${icon(i.i)}</span><span class="insight-text">${i.t}</span></div>`).join('');
}

/* ==================== EXTRATO ==================== */
function updateMonthLabel(){
  document.getElementById('month-label').textContent = MONTHS_S[exMonth.getMonth()]+' '+exMonth.getFullYear();
}

function getFiltered(){
  return tx.filter(t=>{
    const d = new Date(t.date+'T12:00:00');
    if(d.getMonth()!==exMonth.getMonth()||d.getFullYear()!==exMonth.getFullYear()) return false;
    if(fType!=='todos'&&t.type!==fType) return false;
    if(fCat&&t.category!==fCat) return false;
    if(fQ&&!t.description.toLowerCase().includes(fQ.toLowerCase())) return false;
    return true;
  });
}

function renderExtrato(){
  updateMonthLabel();
  const filtered = getFiltered();
  const ent = filtered.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = filtered.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const bal = ent-sai;
  document.getElementById('ext-ent').textContent = fmtR(ent);
  document.getElementById('ext-sai').textContent = fmtR(sai);
  const bEl = document.getElementById('ext-bal');
  bEl.textContent = fmtR(bal);
  bEl.className = 'kpi-value sm '+(bal>=0?'gold':'red');

  const el = document.getElementById('tx-list');
  if(filtered.length===0){
    el.innerHTML=`<div class="empty-state"><div class="empty-icon">${icon('inbox')}</div><p>Nenhuma transação encontrada</p></div>`;
    return;
  }

  const sorted = [...filtered].sort((a,b)=>new Date(b.date)-new Date(a.date));
  const groups={};
  sorted.forEach(t=>{ if(!groups[t.date]) groups[t.date]=[]; groups[t.date].push(t); });

  let html='';
  Object.entries(groups).sort((a,b)=>new Date(b[0])-new Date(a[0])).forEach(([date,items])=>{
    html += `<div class="tx-date-group">${fmtDateFull(date)}</div>`;
    items.forEach(t=>{
      const cat = CAT[t.category]||CAT.outros;
      const sign = t.type==='entrada'?'+':'−';
      const pend = t.status==='pendente';
      const badge = t.type==='saida'
        ? `<span class="tx-badge ${t.status||'pago'}">${icon(pend?'clock':'check')}${pend?'Pendente':'Pago'}</span>`
        : '';
      const d = esc(t.description);
      html += `<div class="tx-item">
        <div class="tx-cat-icon" style="background:${cat.c}1f;color:${cat.c}">${icon(cat.i)}</div>
        <div class="tx-info">
          <div class="tx-desc">${d}</div>
          <div class="tx-meta"><span>${cat.l}</span>${badge}${t.notes?`<span style="color:var(--text3)">• ${esc(t.notes)}</span>`:''}</div>
        </div>
        <div class="tx-right">
          <div class="tx-amount ${t.type}">${sign} ${fmtR(t.amount)}</div>
          <div class="tx-actions">
            <button class="tx-act-btn edit" data-id="${t.id}" aria-label="Editar ${d}">${icon('edit')}</button>
            <button class="tx-act-btn del" data-id="${t.id}" aria-label="Apagar ${d}">${icon('trash')}</button>
          </div>
        </div>
      </div>`;
    });
  });
  el.innerHTML=html;

  el.querySelectorAll('.tx-act-btn.edit').forEach(b=>b.addEventListener('click',()=>openEdit(parseInt(b.dataset.id))));
  el.querySelectorAll('.tx-act-btn.del').forEach(b=>b.addEventListener('click',()=>openDel(parseInt(b.dataset.id))));
}

function buildCatChips(){
  const el = document.getElementById('cat-chips');
  let html = '<button class="filter-chip active" data-fcat="all" aria-pressed="true">Todas</button>';
  Object.entries(CAT).forEach(([k,v])=>{ html+=`<button class="filter-chip" data-fcat="${k}" aria-pressed="false">${icon(v.i)} ${v.l}</button>`; });
  el.innerHTML=html;
  el.querySelectorAll('.filter-chip').forEach(b=>{
    b.addEventListener('click',()=>{
      el.querySelectorAll('.filter-chip').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false');});
      b.classList.add('active'); b.setAttribute('aria-pressed','true');
      fCat = b.dataset.fcat==='all'?null:b.dataset.fcat;
      renderExtrato();
    });
  });
}

/* ==================== RELATÓRIOS ==================== */
function renderRelatorio(){
  const start = document.getElementById('r-start').value;
  const end = document.getElementById('r-end').value;
  if(!start||!end){ toast('Selecione as datas','error'); return; }

  rFiltered = tx.filter(t=>t.date>=start&&t.date<=end);
  const ent = rFiltered.filter(t=>t.type==='entrada').reduce((s,t)=>s+t.amount,0);
  const sai = rFiltered.filter(t=>t.type==='saida').reduce((s,t)=>s+t.amount,0);
  const res = ent-sai;

  document.getElementById('r-ent').textContent=fmtR(ent);
  document.getElementById('r-sai').textContent=fmtR(sai);
  const rEl=document.getElementById('r-res');
  rEl.textContent=fmtR(res);
  rEl.className='kpi-value '+(res>=0?'gold':'red');
  document.getElementById('report-content').style.display='block';

  renderLinha(start,end);
  renderPizza(rFiltered);
  renderBreakdown(rFiltered);
}

function renderLinha(start,end){
  const sorted=[...rFiltered].sort((a,b)=>new Date(a.date)-new Date(b.date));
  const dateMap={};
  sorted.forEach(t=>{ dateMap[t.date]=(dateMap[t.date]||0)+(t.type==='entrada'?t.amount:-t.amount); });
  const dates=Object.keys(dateMap).sort();
  let run=0; const labels=[],vals=[];
  dates.forEach(d=>{ run+=dateMap[d]; labels.push(fmtDate(d)); vals.push(run); });

  if(charts.linha) charts.linha.destroy();
  const ctx=document.getElementById('r-linha').getContext('2d');
  if(!labels.length) return;
  charts.linha=new Chart(ctx,{
    type:'line',
    data:{labels,datasets:[{label:'Saldo',data:vals,borderColor:'#daa520',backgroundColor:'rgba(218,165,32,.07)',borderWidth:2,pointRadius:3,pointBackgroundColor:'#daa520',fill:true,tension:.3}]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}},
      scales:{
        x:{ticks:{font:{size:11},maxTicksLimit:8},grid:{color:'#252535'}},
        y:{ticks:{font:{size:11},callback:v=>v>=1000?'R$'+(v/1000).toFixed(0)+'k':'R$'+v},grid:{color:'#252535'}}
      }
    }
  });
}

function renderPizza(filtered){
  const cMap={};
  filtered.filter(t=>t.type==='saida').forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  if(charts.pizza) charts.pizza.destroy();
  const ctx=document.getElementById('r-pizza').getContext('2d');
  if(!Object.keys(cMap).length) return;
  const keys=Object.keys(cMap);
  charts.pizza=new Chart(ctx,{
    type:'doughnut',
    data:{labels:keys.map(k=>CAT[k]?.l||k),
      datasets:[{data:keys.map(k=>cMap[k]),backgroundColor:keys.map(k=>CAT[k]?.c||'#6b7280'),borderColor:'#161621',borderWidth:2,hoverOffset:6}]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{font:{size:11},boxWidth:10,padding:8}},
        tooltip:{callbacks:{label:c=>` ${fmtR(c.raw)}`}}}}
  });
}

function renderBreakdown(filtered){
  const cMap={};
  filtered.filter(t=>t.type==='saida').forEach(t=>{ const c=t.category||'outros'; cMap[c]=(cMap[c]||0)+t.amount; });
  const total=Object.values(cMap).reduce((s,v)=>s+v,0);
  const sorted=Object.entries(cMap).sort((a,b)=>b[1]-a[1]);
  const el=document.getElementById('cat-breakdown');
  if(!sorted.length){ el.innerHTML=`<div class="empty-state"><div class="empty-icon">${icon('inbox')}</div><p>Nenhuma despesa no período</p></div>`; return; }
  el.innerHTML=sorted.map(([k,v])=>{
    const cat=CAT[k]||CAT.outros;
    const pct=total>0?(v/total*100).toFixed(1):0;
    return `<div class="cat-row">
      <div class="cat-row-icon" style="color:${cat.c}">${icon(cat.i)}</div>
      <div class="cat-row-info">
        <div class="cat-row-label"><span>${cat.l}</span><span class="cat-val">${fmtR(v)} <span style="color:var(--text3);font-family:'DM Sans',sans-serif;font-size:.78rem;font-weight:400">(${pct}%)</span></span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${cat.c}"></div></div>
      </div>
    </div>`;
  }).join('');
}

/* ==================== CAT GRID ==================== */
function buildCatGrid(gridId, selected, onSel){
  const el=document.getElementById(gridId);
  // <button> em vez de <div>: recebe foco e responde a Enter/Espaco sem gambiarra.
  el.innerHTML=Object.entries(CAT).map(([k,v])=>`
    <button type="button" class="cat-opt ${k===selected?'sel':''}" data-cat="${k}"
            role="radio" aria-checked="${k===selected?'true':'false'}" tabindex="${k===selected?'0':'-1'}">
      <span class="ce">${icon(v.i)}</span><span class="cn">${v.l}</span>
    </button>`).join('');
  const opts=[...el.querySelectorAll('.cat-opt')];
  const select=opt=>{
    opts.forEach(x=>{x.classList.remove('sel');x.setAttribute('aria-checked','false');x.tabIndex=-1;});
    opt.classList.add('sel'); opt.setAttribute('aria-checked','true'); opt.tabIndex=0;
    onSel(opt.dataset.cat);
  };
  opts.forEach((opt,idx)=>{
    opt.addEventListener('click',()=>select(opt));
    opt.addEventListener('keydown',e=>{
      const map={ArrowRight:1,ArrowDown:4,ArrowLeft:-1,ArrowUp:-4};
      if(!(e.key in map)) return;
      e.preventDefault();
      const next=opts[(idx+map[e.key]+opts.length)%opts.length];
      select(next); next.focus();
    });
  });
}

/* ==================== INFRA DE MODAL ==================== */
let lastFocus = null;

function modalAberto(){ return document.querySelector('.modal-overlay.open'); }

function abrirModal(id){
  lastFocus = document.activeElement;           // para devolver o foco ao fechar
  document.getElementById(id).classList.add('open');
}
function fecharModal(id){
  const m = document.getElementById(id);
  if(!m.classList.contains('open')) return;
  m.classList.remove('open');
  if(lastFocus && document.contains(lastFocus)) lastFocus.focus();
  lastFocus = null;
}

/* Sem isto o Tab escapa do dialogo e passeia pela pagina atras dele. */
function prenderTab(e){
  if(e.key !== 'Tab') return;
  const m = modalAberto();
  if(!m) return;
  const foco = [...m.querySelectorAll('button,input,select,textarea,[tabindex]:not([tabindex="-1"])')]
    .filter(el => !el.disabled && el.offsetParent !== null);
  if(!foco.length) return;
  const primeiro = foco[0], ultimo = foco[foco.length - 1];
  if(e.shiftKey && document.activeElement === primeiro){ e.preventDefault(); ultimo.focus(); }
  else if(!e.shiftKey && document.activeElement === ultimo){ e.preventDefault(); primeiro.focus(); }
}

/* Mensagem de erro ao lado do campo, e nao apenas num toast no canto da tela. */
function setErr(campoId, erroId, msg){
  const campo = document.getElementById(campoId);
  const box = document.getElementById(erroId);
  if(msg){
    campo.setAttribute('aria-invalid','true');
    box.classList.add('show');
    box.querySelector('span').textContent = msg;
  }else{
    campo.removeAttribute('aria-invalid');
    box.classList.remove('show');
    box.querySelector('span').textContent = '';
  }
  return !msg;
}
function limparErros(p){
  ['desc','val','date'].forEach(k => setErr(`${p}-${k}`, `${p}-${k}-err`, ''));
}
/* Valida os tres campos obrigatorios e devolve o valor ja normalizado. */
function validar(p){
  const desc = document.getElementById(`${p}-desc`).value.trim();
  const val = parseVal(document.getElementById(`${p}-val`).value);
  const date = document.getElementById(`${p}-date`).value;
  let ok = true;
  ok = setErr(`${p}-desc`, `${p}-desc-err`, desc ? '' : 'Informe uma descrição.') && ok;
  ok = setErr(`${p}-val`, `${p}-val-err`,
        (!isNaN(val) && val > 0) ? '' : 'Informe um valor maior que zero. Ex.: 1250,90') && ok;
  ok = setErr(`${p}-date`, `${p}-date-err`, date ? '' : 'Informe a data.') && ok;
  if(!ok){
    const primeiro = document.querySelector(`#${p === 'a' ? 'add' : 'edit'}-modal [aria-invalid="true"]`);
    if(primeiro) primeiro.focus();
    return null;
  }
  return { desc, val: Math.round(val * 100) / 100, date };
}

